# Copy this file to ".env" and fill in your key.
#   cp .env.example .env
#
# Get an API key at https://console.anthropic.com/  ->  "API Keys".

ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional settings (sensible defaults shown) ----

# Which Claude model drives the agent.
DESKTOP_AGENT_MODEL=claude-opus-4-8

# How hard the model thinks/works. low | medium | high | xhigh | max
DESKTOP_AGENT_EFFORT=high

# Safety. "ask"  = pause for your y/N approval before shell commands and file
#                  writes (recommended).
#         "yolo" = never ask, run everything automatically. Use only in a
#                  throwaway VM you don't care about.
DESKTOP_AGENT_MODE=ask

# Max agent steps per task before it stops on its own (prevents runaways / cost blowups).
DESKTOP_AGENT_MAX_STEPS=60
